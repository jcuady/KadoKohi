# Supabase project URL for browser client.
# Production: idwtlujcdfnnndxmlaco (KadoKohi)
VITE_SUPABASE_URL="https://idwtlujcdfnnndxmlaco.supabase.co"

# Preferred public key for browser client.
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxx"

# Optional legacy anon key (fallback for older clients/tools).
VITE_SUPABASE_ANON_KEY=""

# Project id used for MCP/CLI operations.
SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"

# Personal access token for Supabase MCP/CLI.
SUPABASE_ACCESS_TOKEN="sbp_xxxxxxxxxxxxxxxxx"

# Server-only key, never expose via VITE_* vars.
SUPABASE_SERVICE_ROLE_KEY=""

# Public site URL for QR links and canonical URLs (Vercel production).
VITE_SITE_URL="https://www.kadokohi.com"
SITE_URL="https://www.kadokohi.com"
# Supabase Auth → URL Configuration must allow:
#   http://127.0.0.1:5174/**
#   http://localhost:5174/**
#   https://www.kadokohi.com/**
#   https://kado-kohi.vercel.app/**   (optional — Vercel preview deploys)
# Email templates: paste confirmsignup.html + resetpassword.html in Authentication → Emails

# Optional: refresh homepage Google reviews via npm run sync:google-reviews
GOOGLE_PLACES_API_KEY=""

# Contact form + Kado Circle (Supabase edge function kk-send-contact)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Kado Kohi <hello@kadokohi.com>"
KADO_INBOUND_EMAIL="kadocoffeeph@gmail.com"

# Web push — client-readable public key (must match edge function secret).
VITE_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@kadokohi.com"

# --- Vercel (Settings → Environment Variables) — browser vars only ---
# VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY, VITE_SITE_URL, VITE_VAPID_PUBLIC_KEY
# Do NOT add SUPABASE_SERVICE_ROLE_KEY or RESEND_API_KEY to Vercel (secrets live in Supabase).

